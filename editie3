<script>
function toggleMenu() {
  document.getElementById('mobileMenu').classList.toggle('open');
}

(async () => {
  try {
    const res = await fetch('https://firestore.googleapis.com/v1/projects/wtc-saloncoureurs/databases/(default)/documents/stats?pageSize=50');
    if (!res.ok) return;
    const data = await res.json();
    const docs = data.documents || [];
    const totaal = docs.reduce((som, doc) => {
      const f = doc.fields || {};
      return som + parseFloat(f.totalKm?.doubleValue || f.totalKm?.integerValue || 0);
    }, 0);
    const doel = 40000;
    const pct = Math.min((totaal / doel) * 100, 100);
    const afgerond = Math.round(totaal);

    document.getElementById('seizoen-km').innerHTML =
      `${afgerond.toLocaleString('nl-BE')} <span class="stat-unit">/ 40.000 km</span>`;
    document.getElementById('seizoen-km-bar').style.width = pct.toFixed(1) + '%';
    document.getElementById('seizoen-km-pct').textContent = pct.toFixed(1) + '% voltooid';
  } catch (e) {
    console.warn('Seizoensdoel km kon niet geladen worden:', e);
  }
})();
</script>
